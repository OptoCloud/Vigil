{
	"extends": "$app/tsconfig",
	"include": ["src", "test", "*"],
	"exclude": ["src/service-worker"],
	// $app/tsconfig, which SvelteKit writes into node_modules on sync, carries the module and
	// resolution settings. Only what it leaves out is set here.
	"compilerOptions": {
		"strict": true,
		"sourceMap": true
	}
}

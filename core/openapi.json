{
  "openapi": "3.1.0",
  "info": {
    "title": "vigil-core",
    "summary": "The hardware state of one NAS host, read-only.",
    "description": "Every route is a GET that changes nothing, and none needs authentication: what is served is published (ADR-023). Each client address gets 200 requests in a burst and 20 a second after that; past it the answer is 429. Generated by the vigil-core tests; do not edit. The examples are core/contract.json's.",
    "license": {
      "name": "AGPL-3.0-or-later",
      "identifier": "AGPL-3.0-or-later"
    },
    "version": "unversioned"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness: 200 once running, whatever else is wrong.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The text \"ok\".",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "summary": "Readiness, and the running version.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The runtime's loop is turning and vigild is connected.",
            "content": {
              "application/json": {
                "example": {
                  "ready": true,
                  "version": "v1.2.3",
                  "daemonConnected": true,
                  "lastSnapshot": "2026-09-21T23:01:34.155Z",
                  "databaseReady": true,
                  "loopAgeSeconds": 0.5
                }
              }
            }
          },
          "503": {
            "description": "Not ready. The same body, with ready false.",
            "content": {
              "application/json": {
                "example": {
                  "ready": true,
                  "version": "v1.2.3",
                  "daemonConnected": true,
                  "lastSnapshot": "2026-09-21T23:01:34.155Z",
                  "databaseReady": true,
                  "loopAgeSeconds": 0.5
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "The current state as Prometheus gauges. What is unknown is absent, never zero.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Prometheus text exposition format, version 0.0.4.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/live": {
      "get": {
        "summary": "Server-Sent Events: the current state on connect, then every change.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "A stream. Each event's data is one JSON message whose \"type\" says which (core/contract.json, liveMessages). An event named \"keepalive\" follows 20 seconds of quiet.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Too many live streams are open: 64 in all, 8 from one client.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/history": {
      "get": {
        "summary": "Chart history for one range, bucketed.",
        "parameters": [
          {
            "name": "range",
            "in": "query",
            "required": true,
            "description": "How long a window, which also sets the resolution.",
            "schema": {
              "type": "string",
              "enum": [
                "1h",
                "6h",
                "24h",
                "7d",
                "30d",
                "1y"
              ]
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "Where the window ends, in milliseconds since 1970, for a look further back. Now when omitted.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Every series as [epochMillis, value] points.",
            "content": {
              "application/json": {
                "example": {
                  "range": "24h",
                  "from": 1789945200000,
                  "to": 1790031600000,
                  "bucketSeconds": 300,
                  "temperatures": {
                    "drive:naa.5000c500a1b2c3d4": [
                      [
                        1790031600000,
                        34.5
                      ]
                    ]
                  },
                  "duties": {
                    "drive-cage": [
                      [
                        1790031600000,
                        65.5
                      ]
                    ]
                  },
                  "rpms": {
                    "drive-cage": [
                      [
                        1790031600000,
                        1211.5
                      ]
                    ]
                  },
                  "ups": {
                    "charge": [
                      [
                        1790031600000,
                        100.5
                      ]
                    ]
                  },
                  "host": {
                    "cpuBusy": [
                      [
                        1790031600000,
                        18.5
                      ]
                    ]
                  },
                  "trafficIn": {
                    "net:vmbr0": [
                      [
                        1790031600000,
                        2500000.5
                      ]
                    ]
                  },
                  "trafficOut": {
                    "net:vmbr0": [
                      [
                        1790031600000,
                        600000.5
                      ]
                    ]
                  },
                  "busy": {
                    "disk:naa.5000c500a1b2c3d4": [
                      [
                        1790031600000,
                        12.5
                      ]
                    ]
                  },
                  "poolFill": {
                    "tank": [
                      [
                        1790031600000,
                        40.5
                      ]
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "range is missing or not one of the ranges, or to is not a time in the past.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "The database could not be reached.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/events": {
      "get": {
        "summary": "The event log, newest first. An empty list when the database is down.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "How many, 50 when omitted.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Only events older than the one with this id: the oldest id of the page before.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "severity",
            "in": "query",
            "required": false,
            "description": "Only this severity and worse.",
            "schema": {
              "type": "string",
              "enum": [
                "info",
                "warning",
                "critical"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of events.",
            "content": {
              "application/json": {
                "example": [
                  {
                    "id": 1,
                    "ts": "2026-09-21T23:01:34.155Z",
                    "severity": "warning",
                    "kind": "fan-stalled:drive-cage",
                    "message": "drive-cage is being driven at 65% but reads 0 RPM"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "A parameter is out of range.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/drives/{wwn}/history": {
      "get": {
        "summary": "One drive's recorded SMART changes, newest first, at most 200.",
        "parameters": [
          {
            "name": "wwn",
            "in": "path",
            "required": true,
            "description": "The drive's stable name, as the live stream gives it.",
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A row for each time a count moved. Empty for a drive vigil has never seen.",
            "content": {
              "application/json": {
                "example": [
                  {
                    "ts": "2026-10-08T04:46:54.000Z",
                    "passed": true,
                    "reallocatedSectorCount": 0,
                    "pendingSectorCount": 8,
                    "powerOnHours": 8760,
                    "reportedUncorrect": 0,
                    "commandTimeout": 0,
                    "udmaCrcErrorCount": 0,
                    "lastSelfTestPassed": true
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Not a drive name.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "The database could not be reached.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}

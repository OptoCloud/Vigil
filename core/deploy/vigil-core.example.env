# An example /etc/vigil-core.env: copy it, and change the addresses and names to yours.
#
# Holds the database password, so the installed file is a secret: 0640 root:vigil, never in git.
#   install -o root -g vigil -m 0640 vigil-core.env /etc/vigil-core.env
#
# DATABASE_URL is the role that OWNS the schema and writes every row. The history and event
# log queries run as DATABASE_URL_READONLY, a SELECT-only role, so a bug in a query cannot
# write (docs/SECURITY.md §3.4 has the grant).
VIGILD_SOCKET=/mnt/vigil/vigild.sock
DATABASE_URL=postgres://vigil:PASSWORD@db.example.internal:5432/vigil
DATABASE_URL_READONLY=postgres://vigil_web:PASSWORD@db.example.internal:5432/vigil
PERSIST_INTERVAL_SECONDS=10
RAW_RETENTION_DAYS=30
NUT_HOST=nas.example.internal
NUT_PORT=3493
NUT_UPS=apc
# How long the host takes to shut down, guests included: measure it, and take the slowest.
# upsmon starts the shutdown at battery.runtime.low (ups.conf can override the UPS's own
# value); the dashboard shows what that leaves, and an alert fires if it leaves nothing.
# HOST_SHUTDOWN_SECONDS=90
# UPS_BATTERY_TEMPERATURE_WARN=40
# °C at which a sensor is a warning and a critical, by category. These are the defaults; name
# only the ones to change.
# TEMPERATURE_LIMITS=cpu:85/95,boardAmbient:50/60,drive:50/60,gpu:85/95,memory:70/85,hba:75/85

# Every alert needs vigil-core alive to send it. A heartbeat service (healthchecks.io, Uptime
# Kuma's push monitor) alerts when these requests stop: a dead vigil-core, guest or host.
# HEARTBEAT_URL=https://hc-ping.com/your-check-id
# HEARTBEAT_INTERVAL_SECONDS=60

# Alerts reach a person by text, by email, or both (docs/DECISIONS.md ADR-028). Warnings and
# worse are sent, each with its all-clear; a send that fails is retried for a quarter of an hour.
# An SMS gateway (README, "The SMS gateway's contract"). Both or neither.
# SMS_URL=http://<the gateway>/send
# SMS_TOKEN=
# Email: host, from and to go together. 587 with STARTTLS is the default; set
# SMTP_STARTTLS=false only for a relay on the LAN that asks for no login.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=vigil@example.com
# EMAIL_TO=you@example.com,someone@example.com

# Hot spares each pool should have AVAIL: one fewer is a warning. 35 days of scrub age is one
# missed monthly scrub. Leave the self-test age unset until smartd schedules tests, or every
# drive would be overdue; 8 suits a weekly long test.
# ZFS_EXPECTED_SPARES=tank:2
# ZFS_SCRUB_MAX_AGE_DAYS=35
# SMART_SELF_TEST_MAX_AGE_DAYS=8

# The dashboard: public, read-only, no authentication (docs/DECISIONS.md ADR-023). vigil-core
# speaks plain HTTP: it goes behind a proxy or tunnel that terminates TLS, never onto a
# forwarded port.
CORE_HOST=0.0.0.0
CORE_PORT=3000
# Who is in front, as vigil-core sees the connection: addresses, networks, or "cloudflare" for
# the ranges Cloudflare publishes (fetched at start and daily). Behind a tunnel or a proxy on
# the same network, what connects is the tunnel's daemon, not Cloudflare's edge: name the
# address it reaches vigil-core from, 127.0.0.1 if it runs on this machine. Without this every
# visitor is counted as the proxy, and shares one client's limits; vigil-core warns once when
# it sees that.
# TRUSTED_PROXIES=127.0.0.1
# The public host name, and any name a health check uses. Other Host headers get a 400.
# ALLOWED_HOSTS=vigil.example.com;localhost

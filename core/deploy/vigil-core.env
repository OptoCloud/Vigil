# /etc/vigil-core.env
#
# Holds the database password, so this file is a secret: 0640 root:vigil, never in git.
#   install -o root -g vigil -m 0640 vigil-core.env /etc/vigil-core.env
#
# DATABASE_URL is the role that OWNS the schema and writes every row. The history and event
# log queries run as DATABASE_URL_READONLY, a SELECT-only role, so a bug in a query cannot
# write (docs/SECURITY.md §3.4 has the grant).
VIGILD_SOCKET=/mnt/vigil/vigild.sock
DATABASE_URL=postgres://vigil:PASSWORD@192.0.2.130:5432/vigil
DATABASE_URL_READONLY=postgres://vigil_web:PASSWORD@192.0.2.130:5432/vigil
PERSIST_INTERVAL_SECONDS=10
RAW_RETENTION_DAYS=30
NUT_HOST=192.0.2.4
NUT_PORT=3493
NUT_UPS=apc
# How long the host takes to shut down, guests included: the slower of its last two (45 and 84 s).
# upsmon starts the shutdown at battery.runtime.low, 600 s since the host's ups.conf overrides it
# (the UPS's own signal came at 120 s, measured over USB); the dashboard shows what that leaves, and an alert fires
# if it leaves nothing.
HOST_SHUTDOWN_SECONDS=84
# UPS_BATTERY_TEMPERATURE_WARN=40
# NTFY_URL=https://ntfy.sh/your-private-topic
# The SMS gateway on the host (README, "The SMS gateway's contract"). Both or neither.
# SMS_URL=http://<the gateway>/send
# SMS_TOKEN=

# tank's two hot spares in the 4-bay: one fewer AVAIL is a warning. Scrubs are monthly, so 35
# days is one missed. The self-test age stays unset until smartd schedules tests on the host,
# or every drive would be overdue; 8 suits a weekly long test.
ZFS_EXPECTED_SPARES=tank:2
# ZFS_SCRUB_MAX_AGE_DAYS=35
# SMART_SELF_TEST_MAX_AGE_DAYS=8

# The dashboard: public, read-only, no authentication (docs/DECISIONS.md ADR-023). Port 3000,
# where vigil-web used to answer, so existing bookmarks keep working. vigil-core speaks plain
# HTTP: it goes behind a proxy or tunnel that terminates TLS, never onto a forwarded port.
CORE_HOST=0.0.0.0
CORE_PORT=3000
# Who is in front, as vigil-core sees the connection: addresses, networks, or "cloudflare" for
# the ranges Cloudflare publishes (fetched at start and daily). the host is behind a Cloudflare
# Tunnel, so what connects is cloudflared, not Cloudflare's edge: name the address cloudflared
# reaches vigil-core from, 127.0.0.1 if it runs in this guest. Without this every visitor is
# counted as the proxy, and shares one client's limits; vigil-core warns once when it sees that.
# TRUSTED_PROXIES=127.0.0.1
# The public host name, and any name a health check uses. Other Host headers get a 400.
# ALLOWED_HOSTS=vigil.example.com;localhost
